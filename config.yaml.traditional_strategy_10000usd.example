BITFINEX_API_KEY: "your_api_key_here"
BITFINEX_SECRET_KEY: "your_secret_key_here"

CURRENCY: "USD"

# 调度
ORDER_LIMIT: 10
RUN_ONLY_ON_NEW_CREDITS: false
MINUTES_RUN: 10
LENDING_CHECK_MINUTES: 5

# 资金限制
MIN_LOAN: 150
MAX_LOAN: 2000
RESERVE_AMOUNT: 0

# 传统策略：大部分资金贴近市场利率成交
MIN_DAILY_LEND_RATE: 0.03
SPREAD_LEND: 6
GAP_BOTTOM: 2
GAP_TOP: 18
RATE_BONUS: 0.001

# 自动期限
LOAN_DAYS: 0
THIRTY_DAY_LEND_RATE_THRESHOLD: 0.03
SIXTY_DAY_LEND_RATE_THRESHOLD: 0.035
NINETY_DAY_LEND_RATE_THRESHOLD: 0.04
ONE_TWENTY_DAY_LEND_RATE_THRESHOLD: 0.045

# 少量高利率挂单
HIGH_HOLD_RATE: 0.05
HIGH_HOLD_AMOUNT: 1000
HIGH_HOLD_ORDERS: 1

# 明确关闭其他策略
ENABLE_SMART_STRATEGY: false
VOLATILITY_THRESHOLD: 0.002
MAX_RATE_MULTIPLIER: 2.0
MIN_RATE_MULTIPLIER: 0.8
RATE_RANGE_INCREASE_PERCENT: 0.1
FUNDING_BOOK_RATE_UNDERCUT: 0.000001

ENABLE_KLINE_STRATEGY: false
KLINE_TIME_FRAME: "15m"
KLINE_PERIOD: 24
KLINE_SPREAD_PERCENT: 0
KLINE_SMOOTH_METHOD: "ema"

# 通知
TELEGRAM_BOT_TOKEN: "your_telegram_bot_token_here"
TELEGRAM_AUTH_TOKEN: "your_secure_auth_token_here"
NOTIFY_RATE_THRESHOLD: 0.045

# 先用测试模式观察挂单行为
TEST_MODE: true
