BITFINEX_API_KEY: "your_api_key_here"
BITFINEX_SECRET_KEY: "your_secret_key_here"

CURRENCY: "usd"

ORDER_LIMIT: 5 # 每次挂单只挂几笔，避免一次挂太多都成立，错过大利率
RUN_ONLY_ON_NEW_CREDITS: false # true 时仅在新借贷成交或可用余额显著增加时重跑策略
MINUTES_RUN: 10 # 每隔几分钟执行一次

MIN_LOAN: 150 # 每笔最小金额
#MAX_LOAN: 150 # 每笔最大金额

MIN_DAILY_LEND_RATE: 0.029 # 最小利率（可设为 FRR，仅分散单改用 FRR 模式；高额持有单维持 HIGH_HOLD_RATE）
SPREAD_LEND: 30 # 分散单最大目标笔数
GAP_BOTTOM: 10 # 参数是指 ask 挂单里面第几个 index 下限，通常有好几千个挂单
GAP_TOP: 5000 # 参数是指 ask 挂单里面第几个 index 上限，通常有好几千个挂单
THIRTY_DAY_LEND_RATE_THRESHOLD: 0.03 # 超过多少就挂 30 天的单
SIXTY_DAY_LEND_RATE_THRESHOLD: 0.035 # 超过多少就挂 60 天的单
NINETY_DAY_LEND_RATE_THRESHOLD: 0.04 # 超过多少就挂 90 天的单
ONE_TWENTY_DAY_LEND_RATE_THRESHOLD: 0.05 # 超过多少就挂 120 天的单
HIGH_HOLD_RATE: 0.06
HIGH_HOLD_AMOUNT: 2000
HIGH_HOLD_ORDERS: 1
RATE_BONUS: 0.002 # 当下次执行时没有未成功订单时就加利率（避免订单成功全都在低利率上）

TELEGRAM_BOT_TOKEN: "your_telegram_bot_token_here"
TELEGRAM_AUTH_TOKEN: "your_secure_auth_token_here"

NOTIFY_RATE_THRESHOLD: 0.045
RESERVE_AMOUNT: 0
NOTIFICATION_FORMAT: "classic" # classic 为现有纯文本格式，aligned 为 <pre> 对齐格式

ENABLE_SMART_STRATEGY: true # 启用智能策略
VOLATILITY_THRESHOLD: 0.002      # 高波动阈值（默认: 0.002）
MAX_RATE_MULTIPLIER: 2.0         # 最大利率倍数（默认: 2.0）
MIN_RATE_MULTIPLIER: 0.8         # 最小利率倍数（默认: 0.8）
RATE_RANGE_INCREASE_PERCENT: 0.6 # 利率范围增加百分比（默认: 0.2 = 20%）
FUNDING_BOOK_RATE_UNDERCUT: 0.000001 # Funding Book 利率下调量，百分比格式；0.000001 表示从 0.030137% 挂到 0.030136%

ENABLE_KLINE_STRATEGY: false
KLINE_TIME_FRAME: "15m"
KLINE_PERIOD: 24
KLINE_SPREAD_PERCENT: 0
KLINE_SMOOTH_METHOD: "ema"

LENDING_CHECK_MINUTES: 5 # 每隔五分钟检查是否有成功借贷的订单
TEST_MODE: true
