# =========================
# Bitfinex API 认证
# =========================
BITFINEX_API_KEY:               ""                 # Bitfinex API Key；需要具备 Funding 相关权限
BITFINEX_SECRET_KEY:            ""                 # Bitfinex API Secret；与 API Key 配套使用

# =========================
# Telegram 机器人（可选）
# =========================
TELEGRAM_BOT_TOKEN:             ""                 # Telegram Bot Token；与 TELEGRAM_AUTH_TOKEN 同时配置时启用 Telegram 控制与通知
TELEGRAM_AUTH_TOKEN:            ""                 # Telegram 鉴权口令；与 TELEGRAM_BOT_TOKEN 同时配置时启用
# 若任一 Telegram 配置缺失，程序会自动降级为无 Telegram 模式，但主策略仍会继续运行
# 运行中通过 Telegram 修改的参数会写入 data.json，重启后优先恢复最近一次运行时修改值
# 当前允许运行时修改的参数包括：
# NOTIFY_RATE_THRESHOLD / RESERVE_AMOUNT / ORDER_LIMIT / LOAN_DAYS / MIN_DAILY_LEND_RATE
# MIN_LOAN / MAX_LOAN / HIGH_HOLD_RATE / HIGH_HOLD_AMOUNT / HIGH_HOLD_ORDERS
# RATE_RANGE_INCREASE_PERCENT / STRATEGY / KLINE_SMOOTH_METHOD
# 其余参数默认按“仅启动时读取”处理

# =========================
# 通知设定
# =========================
NOTIFY_RATE_THRESHOLD:         0.045               # 利率通知阈值；每小时检查最近 12 根 5 分钟 K 线高点，超过时发送 Telegram 通知
NOTIFICATION_FORMAT:           "classic"           # 通知格式；classic 为纯文本，aligned 为 <pre> 对齐格式

# =========================
# 基本运行设定
# =========================
TEST_MODE:                     true                 # 是否启用测试模式；true 只模拟下单不提交真实订单
CURRENCY:                      "usd"                # 放贷币种；会自动转换为 funding symbol，例如 usd -> fUSD
STRATEGY:                      "smart"              # 当前策略；可选 traditional | simple | smart | kline
ORDER_LIMIT:                   5                    # 单次主流程最多提交几笔订单；0 表示不限制
RUN_ONLY_ON_NEW_CREDITS:       false                # 是否只在新借贷成交或余额显著增加时重跑主流程
MINUTES_RUN:                   10                   # 主流程定时执行间隔（分钟）；仅在 RUN_ONLY_ON_NEW_CREDITS=false 时生效
LENDING_CHECK_MINUTES:         5                    # 借贷检查调度间隔（分钟）；用于检测新成交、余额变化和发送借贷通知
EXECUTION_COOLDOWN_SECONDS:    30                   # 主策略两次执行之间的最小冷却时间（秒）；防止短时间重复执行
MIN_EXECUTABLE_FUNDS:          0                    # 最小可执行资金阈值；大于 0 时，低于该值的本轮执行会直接跳过
ORDER_FINGERPRINT_TTL_SECONDS: 120                  # 相同订单指纹的短窗口幂等保护时长（秒）
DAILY_EARNINGS_REPORT:                              # 每日收益报告调度配置；影响自动触发时刻、统计窗口和去重日期口径
  ENABLED:                   true                   # 是否启用每日收益报告自动调度
  TRIGGER_TIME:              "09:35"               # 自动触发时间；格式固定为 HH:MM
  TIMEZONE:                  "Asia/Shanghai"       # 调度与统计口径使用的 IANA 时区，例如 Asia/Shanghai / UTC

# =========================
# 贷出金额控制
# =========================
MIN_LOAN:                      150                  # 单笔最小贷出金额；低于该值的订单不会创建
# MAX_LOAN:                    150                  # 单笔最大贷出金额；注释掉或设为 0 表示不限制
RESERVE_AMOUNT:                0                    # 预留不参与放贷的金额；执行前会先从可用余额中扣除

# =========================
# 利率与分散单通用设定
# =========================
MIN_DAILY_LEND_RATE:            0.029              # 最低日利率；可填数值或 FRR，FRR 时仅分散单使用浮动利率模式
SPREAD_LEND:                    30                 # 分散单最大目标笔数；实际笔数还会受资金、MIN_LOAN、MAX_LOAN 和 ORDER_LIMIT 影响
RATE_BONUS:                     0.002              # 无既有未成交订单时附加的利率加成；避免全部订单都成交在过低利率
LOAN_PERIOD_THRESHOLDS:                             # 期限阈值字典；key=天数，value=触发该天数的日利率阈值（百分比）
  30:                         0.03                 # 日利率达到 0.03% 时可挂 30 天
  60:                         0.035                # 日利率达到 0.035% 时可挂 60 天
  90:                         0.04                 # 日利率达到 0.04% 时可挂 90 天
  120:                        0.05                 # 日利率达到 0.05% 时可挂 120 天
LOAN_DAYS:                     0                   # 固定借贷天数；0 表示按策略和阈值自动决定，2-120 表示固定期限

# =========================
# 高额挂单持有策略
# =========================
HIGH_HOLD_RATE:                0.05                # 高额持有单的基础日利率；传统策略固定使用，simple/smart 会以此为基准动态调整
HIGH_HOLD_AMOUNT:              1000                # 单笔高额持有目标金额；simple/传统可在余额不足时降为剩余余额，smart 需满足配比条件
HIGH_HOLD_ORDERS:              1                   # 高额持有订单数量；大于 1 时会尝试拆成多笔相同金额的高额持有单

# =========================
# 传统策略深度参数
# 仅 STRATEGY=traditional 时生效
# =========================
GAP_BOTTOM:                     10                 # Funding Book 索引下限；表示从第几个单边 ask 档位开始取价
GAP_TOP:                        5000               # Funding Book 索引上限；表示最深参考到第几个单边 ask 档位

# =========================
# simple / smart 共用参数
# 仅 STRATEGY=simple 或 smart 时生效
# =========================
VOLATILITY_THRESHOLD:          0.002               # 高波动阈值；超过时 simple/smart 会变得更保守
MAX_RATE_MULTIPLIER:           2.0                 # 动态利率最大倍数；相对 HIGH_HOLD_RATE 的放大上限
MIN_RATE_MULTIPLIER:           0.8                 # 动态利率最小倍数；相对 HIGH_HOLD_RATE 的保底下限
RATE_RANGE_INCREASE_PERCENT:   0.6                 # 分散单利率范围扩展比例；用于构建递增利率序列
FUNDING_BOOK_RATE_UNDERCUT:    0.000001            # Funding Book 压价量；0.000001 表示从 0.030137% 挂到 0.030136%

# =========================
# K 线策略参数
# 仅 STRATEGY=kline 时生效
# =========================
KLINE_TIME_FRAME:              "15m"               # K 线时间框架；可选 5m / 15m / 30m / 1h / 3h / 6h / 12h / 1D
KLINE_PERIOD:                  24                  # 取多少根 K 线用于分析；例如 24 根 15m = 最近 6 小时
KLINE_SPREAD_PERCENT:          0                   # 在 K 线目标利率基础上再增加的百分比；0 表示不额外加成
KLINE_SMOOTH_METHOD:           "ema"               # K 线利率平滑方法；可选 max / sma / ema / hla / p90
